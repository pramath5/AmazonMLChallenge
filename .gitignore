# ----------------
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ----------------
# Virtual environments
# ----------------
venv/
.venv/
env/

# ----------------
# Environment / secrets
# ----------------
.env
.env.*

# ----------------
# Jupyter
# ----------------
.ipynb_checkpoints/

# ----------------
# VS Code
# ----------------
.vscode/

# ----------------
# OS generated files
# ----------------
.DS_Store
Thumbs.db

# ----------------
# Logs
# ----------------
*.log